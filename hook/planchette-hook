#!/bin/sh
# planchette-hook — forwards a coding agent's hook event to the Planchette app.
#
# The agent invokes this with the event JSON on stdin (fields like
# hook_event_name, session_id, transcript_path, cwd, message) and the agent
# label as $1 ("claude", "codex", …). We wrap it with the terminal identity
# from $PLANCHETTE_SESSION (injected into every Planchette terminal, inherited
# by the agent and thus by this hook) and send it to the app's unix socket.
# Spike version — production will be a static binary with proper JSON handling.
#
# Always exit 0: a missing/busy app must never block the agent.

# Not inside a Planchette terminal → nothing to do (keeps the hook a no-op
# for every other agent session on this machine).
[ -n "$PLANCHETTE_SESSION" ] || exit 0

SOCKET="${PLANCHETTE_SOCKET:-/tmp/planchette.sock}"
# A durable terminal's agent outlives the app that started it (see
# Durable.swift), so its $PLANCHETTE_SOCKET names the *old* pid's socket. The
# running app publishes where it actually listens, and we fall back to that —
# otherwise the attention engine goes deaf for exactly the sessions that
# survived. The env var is still tried first: two instances can run at once and
# this terminal belongs to whichever opened it, so the pointer must never
# override a socket that answers.
POINTER=""
[ -r "$HOME/.planchette/socket" ] && POINTER=$(cat "$HOME/.planchette/socket" 2>/dev/null)

# Agent label, passed through unchanged: the app maps an unknown label to "no
# recognized agent", which is the safe answer. Guessing "claude" here would hand
# a foreign agent Claude's authority over this terminal's state. Older installs
# passed no argument at all; those events are Claude's, because it was the only
# integration back then.
agent="${1:-claude}"

payload=$(cat)
[ -n "$payload" ] || payload='{}'

event=$(printf '{"planchette_session":"%s","agent":"%s","event":%s}' \
    "${PLANCHETTE_SESSION:-}" "$agent" "$payload")

# An app that was killed rather than quit leaves its socket file behind, so
# `-S` proves nothing about whether anyone is listening — only a failed send
# does. Try each candidate in turn and stop at the first that accepts.
for target in "$SOCKET" "$POINTER"; do
    [ -n "$target" ] || continue
    # Only a real socket this user owns — never a symlink to one. The default path
    # lives in /tmp, which every user on the machine can write to: after an app
    # dies its pid can be reused and the old name taken by someone else, and an
    # event carries the prompt you just typed. `-S` and `-O` follow a symlink, so a
    # link to MY OWN live socket passes both tests and can then be swapped for the
    # link-maker's listener before `nc` connects. /tmp is sticky: nobody can
    # replace or rename a file that belongs to someone else, so a plain file that
    # passes these tests is still the same file when `nc` opens it.
    [ -L "$target" ] && continue
    [ -S "$target" ] || continue
    [ -O "$target" ] || continue
    if printf '%s' "$event" | nc -U "$target" >/dev/null 2>&1; then
        break
    fi
done

exit 0
