#!/usr/bin/env python3
"""planchette — drive Planchette from inside one of its terminals.

Agents are objects in Planchette (it watches them); this makes them actors
(they can ask it for things). It talks to the same unix socket the hooks use,
one JSON request per connection, one JSON response back.

    planchette session list
    planchette session new --cwd "$PWD"
    planchette session focus --id <uuid>
    planchette session prompt --id <uuid> --text "review the diff"
    planchette session wait --id <uuid> --until ready --timeout-ms 120000
    planchette session read --id <uuid> --lines 80
    planchette notification list --unread-only
    planchette review list --include-team

Only works inside a Planchette terminal: the socket path and the calling
terminal's own id arrive as env vars ($PLANCHETTE_SOCKET, $PLANCHETTE_SESSION).
Prints the JSON response; exits 1 when the app reports a failure, 2 on a usage
error — the same shape the hook uses, so it is safe to script against.

python3 rather than nc: macOS nc cannot half-close a unix socket, so it can
never read a reply (see hook/planchette-hook, which is fire-and-forget).
"""
import argparse
import json
import os
import socket
import stat
import struct
import sys

COMMANDS = {
    "session": ["list", "get", "new", "focus", "prompt", "read", "wait"],
    "project": ["list"],
    # The read side of the notifications panel: the same rows, the same order,
    # every fact the panel prints (state, prompt, age, branch, tags, project).
    "notification": ["list"],
    # The read side of the Reviews panel: the PRs that wait for your review.
    "review": ["list"],
}


def socket_candidates():
    """Where the app might be listening, best guess first.

    $PLANCHETTE_SOCKET carries the pid of the app that opened this terminal. A
    durable terminal (tmux-backed) outlives that app, so after a restart the env
    var names a socket nobody is listening on while the new instance listens
    elsewhere; the running app publishes its current path to ~/.planchette/socket.

    The env var is tried first and only falls through when it cannot be reached —
    never merely because the pointer disagrees. Two instances can run at once,
    and each terminal belongs to the one that opened it; preferring the pointer
    would let the second instance steal the first's terminals. An app that was
    killed leaves its socket *file* behind, so existence proves nothing here and
    only a failed connection does.
    """
    out = []
    env_path = os.environ.get("PLANCHETTE_SOCKET")
    if env_path:
        out.append(env_path)
    try:
        with open(os.path.expanduser("~/.planchette/socket")) as handle:
            pointed = handle.read().strip()
        if pointed and pointed not in out:
            out.append(pointed)
    except OSError:
        pass
    return out


def owned_socket(path):
    """True when `path` is a unix socket owned by the current user.

    The default socket lives in /tmp, which every user can write to, and a
    request can carry anything an agent types into a terminal. Talking to a
    listener someone else put at a predictable name would hand them that text
    and let them answer with whatever they like — so the owner is checked on
    this side too, not only enforced by the app's file mode.
    """
    try:
        # lstat, not stat: a symlink to a socket of mine passes `stat`, and can be
        # swapped for someone else's listener between this check and the connect.
        info = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISSOCK(info.st_mode) and info.st_uid == os.getuid()


def peer_is_me(client):
    """True unless the kernel says the process behind a CONNECTED socket is someone else.

    The path checks above cannot close the gap between checking and connecting on
    their own, so the answer that counts is the kernel's, after the connect:
    LOCAL_PEERCRED (macOS) is the uid of whoever is listening. Where it cannot be
    read, the path checks stand.
    """
    try:
        data = client.getsockopt(0, 1, 76)          # SOL_LOCAL, LOCAL_PEERCRED, sizeof(struct xucred)
        _version, uid = struct.unpack("=II", data[:8])
    except (OSError, struct.error):
        return True
    return uid == os.getuid()


def request(payload, timeout):
    candidates = socket_candidates()
    if not candidates:
        sys.stderr.write(
            "not inside a Planchette terminal ($PLANCHETTE_SOCKET is unset)\n")
        return 2

    # The caller's own terminal, so commands can default to "here".
    session = os.environ.get("PLANCHETTE_SESSION")
    if session:
        payload.setdefault("session", session)

    chunks, last_error = None, None
    for sock_path in candidates:
        if not owned_socket(sock_path):
            last_error = f"{sock_path}: not a socket owned by you"
            continue
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        client.settimeout(timeout)
        try:
            client.connect(sock_path)
            if not peer_is_me(client):
                last_error = f"{sock_path}: the process listening there is not yours"
                continue
            client.sendall(json.dumps(payload).encode())
            client.shutdown(socket.SHUT_WR)  # the app answers on EOF
            received = []
            while True:
                chunk = client.recv(65536)
                if not chunk:
                    break
                received.append(chunk)
            chunks = received
            break
        except OSError as err:
            # Unreachable, so try the next candidate. Only report the failure
            # once every candidate is exhausted.
            last_error = f"{sock_path}: {err}"
        finally:
            client.close()

    if chunks is None:
        sys.stderr.write(f"Planchette is not reachable ({last_error})\n")
        return 2

    raw = b"".join(chunks).decode(errors="replace").strip()
    if not raw:
        sys.stderr.write("no response from Planchette\n")
        return 2
    try:
        response = json.loads(raw)
    except json.JSONDecodeError:
        sys.stderr.write(f"unreadable response: {raw[:400]}\n")
        return 2

    print(json.dumps(response, indent=2, sort_keys=True))
    if not response.get("ok"):
        return 1
    return 0


def main(argv):
    parser = argparse.ArgumentParser(prog="planchette", add_help=True)
    parser.add_argument("group", choices=sorted(COMMANDS), nargs="?")
    parser.add_argument("action", nargs="?")
    parser.add_argument("--id", help="target terminal (default: the calling one)")
    parser.add_argument("--project-id", help="project for session new")
    parser.add_argument("--cwd", help="working directory for session new")
    parser.add_argument("--text", help="text to send for session prompt")
    parser.add_argument(
        "--no-submit", action="store_true", help="type the text without pressing Enter")
    parser.add_argument(
        "--force", action="store_true",
        help="prompt even while a turn is running (interrupts it)")
    parser.add_argument("--lines", type=int, help="lines to return for session read")
    parser.add_argument(
        "--scrollback", action="store_true", help="read history, not just the viewport")
    parser.add_argument(
        "--until", action="append",
        help="state(s) to wait for: ready, waiting, error, free, running")
    parser.add_argument("--timeout-ms", type=int, help="wait timeout (default 120000)")
    parser.add_argument("--focus", action="store_true", help="switch to the new terminal")
    parser.add_argument(
        "--unread-only", action="store_true",
        help="notification list: only terminals whose last report is unread")
    parser.add_argument(
        "--only-active", action="store_true",
        help="notification list: only terminals that wait for you, failed, or finished lately")
    parser.add_argument(
        "--include-running", action="store_true",
        help="notification list: with --only-active, the terminals that are running too")
    parser.add_argument(
        "--limit", type=int, help="notification list: stop after this many rows")
    parser.add_argument(
        "--include-team", action="store_true",
        help="review list: also the requests that went only to one of your teams")
    parser.add_argument(
        "--hide-sent", action="store_true", help="review list: leave out the reviews you sent")
    parser.add_argument(
        "--repo", help="review list: only this repository (owner/name)")
    args = parser.parse_args(argv)

    if not args.group or not args.action:
        # Print the surface instead of guessing: the app is the authority, but a
        # bare invocation should still be useful.
        for group, actions in sorted(COMMANDS.items()):
            print(f"{group}: {' '.join(actions)}")
        return 2
    if args.action not in COMMANDS[args.group]:
        sys.stderr.write(
            f"unknown action \"{args.action}\" for {args.group}: "
            f"{' '.join(COMMANDS[args.group])}\n")
        return 2

    payload = {"planchette_request": f"{args.group}.{args.action}"}
    if args.id:
        payload["id"] = args.id
    if args.project_id:
        payload["project_id"] = args.project_id
    if args.cwd:
        payload["cwd"] = os.path.abspath(args.cwd)
    if args.text is not None:
        payload["text"] = args.text
    if args.no_submit:
        payload["submit"] = False
    if args.force:
        payload["force"] = True
    if args.lines is not None:
        payload["lines"] = args.lines
    if args.scrollback:
        payload["scrollback"] = True
    if args.until:
        payload["until"] = args.until
    if args.timeout_ms is not None:
        payload["timeout_ms"] = args.timeout_ms
    if args.focus:
        payload["focus"] = True
    if args.unread_only:
        payload["unread_only"] = True
    if args.only_active:
        payload["only_active"] = True
    if args.include_running:
        payload["include_running"] = True
    if args.limit is not None:
        payload["limit"] = args.limit
    if args.include_team:
        payload["include_team"] = True
    if args.hide_sent:
        payload["hide_sent"] = True
    if args.repo:
        payload["repo"] = args.repo

    # A wait blocks in the app, so the socket timeout must outlive it.
    wait_ms = args.timeout_ms or (120000 if args.action == "wait" else 10000)
    return request(payload, timeout=wait_ms / 1000 + 5)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
