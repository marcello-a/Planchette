+/// Planchette: see RELEASE_TARGETS_DELAY.
+fn releaseTargetsCallback(
+    self_: ?*Thread,
+    _: *xev.Loop,
+    _: *xev.Completion,
+    r: xev.Timer.RunError!void,
+) xev.CallbackAction {
+    _ = r catch return .disarm;
+    const t = self_ orelse return .disarm;
+    if (t.flags.visible) return .disarm;
+    const since = t.hidden_since orelse return .disarm;
+    const now = std.time.Instant.now() catch return .disarm;
+
+    // Shown and hidden again since the timer started: wait out the rest.
+    const elapsed_ms = now.since(since) / std.time.ns_per_ms;
+    if (elapsed_ms < RELEASE_TARGETS_DELAY) {
+        t.release_h.run(
+            &t.loop,
+            &t.release_c,
+            RELEASE_TARGETS_DELAY - elapsed_ms,
