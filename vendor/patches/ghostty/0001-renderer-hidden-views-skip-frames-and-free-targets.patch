+        /// Planchette: shrink every frame's render target to 1x1. Waits for
+        /// the frames the GPU still draws, as SwapChain.deinit does, so no
+        /// target in flight is freed.
+        fn releaseTargets(self: *Self) void {
+            // Not for an API that re-presents its last target (OpenGL keeps
+            // last_target for presentLastTarget): that one must stay alive.
+            // Metal's layer holds the presented IOSurface on its own.
+            if (comptime @hasField(GraphicsAPI, "last_target")) return;
+
+            self.draw_mutex.lock();
+            defer self.draw_mutex.unlock();
+
+            const chain = &self.swap_chain;
+            if (chain.defunct) return;
+            for (0..chain.frames.len) |_| chain.frame_sema.wait();
+            defer for (0..chain.frames.len) |_| chain.frame_sema.post();
+
+            for (&chain.frames) |*frame| {
+                if (frame.target.width <= 1 and frame.target.height <= 1) continue;
+                frame.resize(self.api, 1, 1) catch |err| {
+                    log.warn("error releasing render target err={}", .{err});
+                    continue;
+                };
+                self.targets_released = true;
+            }
         }
 
